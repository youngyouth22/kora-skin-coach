# Google Gemini LLM API Key (used for Gemini models)
GOOGLE_GENERATIVE_AI_API_KEY=

# Bright Data API (SERP Mega-Query & Web Unlocker)
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=agent_serp
BRIGHTDATA_UNLOCKER_ZONE=agent_unlocker

# YouTube Data API v3 (Official free quota)
YOUTUBE_API_KEY=

# Supabase REST API (Database & products_cache table protected by RLS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase PostgreSQL Storage for Mastra Memory & State (Production)
# Pooler URL (recommended, port 6543) or Direct connection (port 5432)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Mastra server internal authentication secret
MASTRA_API_SECRET=your-internal-api-secret

# Coach / Analyst Model (optional, defaults to google/gemini-2.5-flash)
COACH_MODEL=google/gemini-2.5-flash

# Disable external cloud gateways (Netlify, etc.) to prevent connect timeouts in Studio
AUTO_BLOCK_EXTERNAL_PROVIDERS=true

